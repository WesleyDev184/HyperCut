#!/usr/bin/env bash
# Instala a transcricao em GPU NVIDIA em .cache/whisper-gpu/, sem tocar no sistema. Baixa cerca de 6 GB.
set -euo pipefail

HF_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
D="${WHISPER_GPU_DIR:-$HF_ROOT/.cache/whisper-gpu}"

command -v nvidia-smi >/dev/null || { echo "Sem GPU NVIDIA: bin/hf transcribe segue em CPU." >&2; exit 1; }
"$HF_ROOT/.venv/bin/python" -m venv "$D/venv"
"$D/venv/bin/pip" install -q --disable-pip-version-check \
  faster-whisper==1.2.1 ctranslate2==4.8.5 nvidia-cublas-cu12==12.9.3.13 nvidia-cudnn-cu12==9.28.0.42
HF_HOME="$D/modelos" "$D/venv/bin/python" -c 'from faster_whisper import download_model; download_model("large-v3")'
echo "Pronto: bin/hf transcribe agora usa a GPU."

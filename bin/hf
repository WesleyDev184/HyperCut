#!/usr/bin/env bash
# Roda o CLI do HyperFrames com todo o ambiente desta pasta.
# Uso: hf <comando> [args]   (ex.: ../../bin/hf check --json)
set -euo pipefail

HF_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
source "$HF_ROOT/bin/ambiente.sh"

# Transcricao vai para a GPU. Sem GPU, ou com HF_SEM_GPU=1, segue no CLI em CPU.
if [ "${1:-}" = transcribe ] && [ -z "${HF_SEM_GPU:-}" ]; then
  rc=0
  "$HF_ROOT/bin/transcrever-gpu" "${@:2}" || rc=$?
  [ "$rc" = 0 ] && exit 0
  [ "$rc" = 3 ] || echo "aviso: transcricao na GPU falhou (saida $rc), seguindo em CPU" >&2
fi

exec "$HF_ROOT/node_modules/.bin/hyperframes" "$@"

skills-lock.json

# Prompts pessoais, citam produtos específicos
prompts/

# Ambiente: recriado pelo INSTALACAO.md
node_modules/
.venv/
.cache/
__pycache__/
*.pyc

# Sistema, editor e logs
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
.idea/
.vscode/

